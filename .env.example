# 复制为 .env 后填写。生产/测试的值由 Railway 的环境变量注入，不要提交任何真实值。

# ── 数据库 ────────────────────────────────────────────────────────────────────
# 本机开发（SQLite）：
DATABASE_URL="file:./dev.db"
# Railway（Postgres）：在服务的 Variables 里用引用变量，不要手抄密码
# DATABASE_URL="${{Postgres.DATABASE_URL}}"

# ── 部署环境标识 ──────────────────────────────────────────────────────────────
# development | staging | production
# 决定：seed 是否允许运行、probe 是否允许打过来。漏配按 development 处理。
APP_ENV="development"

# ── 登录会话 ──────────────────────────────────────────────────────────────────
# 每个环境必须用**各自独立**的密钥；测试的密钥泄露不该能伪造生产的会话。
# 生成：openssl rand -base64 32
NEXTAUTH_SECRET=""
# 该环境对外的完整地址，含协议，结尾不要斜杠
NEXTAUTH_URL="http://localhost:3000"

# ── 线索导入 ──────────────────────────────────────────────────────────────────
# 外部表单/脚本调用 /api/leads/import 用的密钥。同样每环境一把。
LEAD_IMPORT_API_KEY=""

# ── 反向代理 ──────────────────────────────────────────────────────────────────
# 按 IP 的登录限流取真实客户端 IP 时，信任的代理层数。Railway/Vercel 这类边缘为 1。
# 直连（无代理）时不要设，设错会让限流可被伪造 x-forwarded-for 绕过。
#
# 注意：按 IP 的限流是进程内的，多实例不共享、重启清零，属尽力而为。
# 真正兜底的是**按账号**的锁定（8 次失败锁 10 分钟），那个落在数据库里，
# 重启与多实例都算数 —— 见 lib/auth.ts。
TRUSTED_PROXY_HOPS="1"

# ── 仅 npm run db:bootstrap 用（生产首次初始化）─────────────────────────────
# 跑完即可从环境变量里删除。密码至少 12 位，且不能是仓库里的演示口令。
# BOOTSTRAP_ADMIN_NAME=""
# BOOTSTRAP_ADMIN_PHONE=""
# BOOTSTRAP_ADMIN_PASSWORD=""

# ── 仅 npm run probe 用 ───────────────────────────────────────────────────────
# 探测目标。缺省 http://localhost:3000。
# 注意：DATABASE_URL 必须指向**同一个环境**的库，否则会跨环境改数据。
# PROBE_BASE="https://vea-ems-staging.up.railway.app"
