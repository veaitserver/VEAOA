generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  roles    UserRole[]
  campuses UserCampus[]

  studentsAsSales    Student[]         @relation("StudentSales")
  studentsAsManager  Student[]         @relation("StudentManager")
  packagesCreated    CoursePackage[]   @relation("PackageCreator")
  packagesConfirmed  CoursePackage[]   @relation("PackageConfirmer")
  packagesFinanceConfirmed CoursePackage[] @relation("PackageFinanceConfirmer")
  followUps          FollowUp[]
  lessonsAsTeacher   ScheduledLesson[]
  lessonLogs         LessonLog[]       @relation("LogTeacher")
  logConfirmations   LessonLog[]       @relation("LogConfirmer")
  deductionReversals CourseDeduction[]
  notifications      Notification[]
  campaignsOwned     Campaign[]        @relation("CampaignOwner")
  deductionUnlocks   CourseDeduction[] @relation("DeductionUnlocker")
  ledgerEntries      LedgerEntry[]     @relation("LedgerCreator")
  refundsCreated     RefundRequest[]   @relation("RefundCreator")
  refundsApproved    RefundRequest[]   @relation("RefundApprover")
  refundsPaid        RefundRequest[]   @relation("RefundPayer")
  refundsRejected    RefundRequest[]   @relation("RefundRejecter")
  attendanceMarked   ScheduledLesson[] @relation("AttendanceMarker")
  classesAsTeacher   GroupClass[]      @relation("ClassTeacher")
  classesCreated     GroupClass[]      @relation("ClassCreator")
  sessionsAsTeacher  GroupSession[]    @relation("SessionTeacher")
  sessionsLogged     GroupSession[]    @relation("SessionLogger")
  sessionsConfirmed  GroupSession[]    @relation("SessionConfirmer")
}

model UserRole {
  userId String
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model UserCampus {
  userId   String
  campusId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@id([userId, campusId])
}

model Campus {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users      UserCampus[]
  students   Student[]
  classrooms Classroom[]
  campaigns  Campaign[]
  groupClasses GroupClass[]
}

model Grade {
  id   String @id @default(cuid())
  name String @unique

  students Student[]
  packages CoursePackage[]
  groupClasses GroupClass[]
}

model Subject {
  id   String @id @default(cuid())
  name String @unique

  packages   CoursePackage[]
  lessonLogs LessonLog[]
  groupClasses GroupClass[]
}

model Student {
  id           String   @id @default(cuid())
  name         String
  // 家长手机号可被多个在读孩子共用，故不能全局唯一。同一学生的判定 = 同校区 + 同号 + 同名。
  phone        String
  // 线索导入时年级可能未知，故可空。建档 UI 仍要求填写。
  gradeId      String?
  publicSchool String?
  salesId      String?
  // 学管：校长确认课包时分配，负责学生学业管理。
  studentManagerId String?
  campusId     String
  // 加拿大用邮编（前三位 FSA）划分营销区域。
  postalCode   String?
  // 家长偏好联系 App 与其账号，contactAppId 参与去重。
  preferredContactApp String?
  contactAppId        String?
  createdAt    DateTime @default(now())

  grade          Grade?  @relation(fields: [gradeId], references: [id])
  sales          User?   @relation("StudentSales", fields: [salesId], references: [id])
  studentManager User?   @relation("StudentManager", fields: [studentManagerId], references: [id])
  campus         Campus  @relation(fields: [campusId], references: [id])

  leadInfo  Lead?
  followUps FollowUp[]
  packages  CoursePackage[]
  lessons   ScheduledLesson[]
  ledgerEntries LedgerEntry[]
  refunds       RefundRequest[]
  classMemberships GroupClassMember[]
  groupAttendances GroupSessionAttendance[]

  // 同校区 + 同号 + 同名 视为同一学生，防止重复建档；兄弟姐妹(同号不同名)不受限。
  @@unique([campusId, phone, name])
  @@index([phone])
  @@index([contactAppId])
}

model Lead {
  studentId String  @id
  source    String  // 兼容旧字段，导入时以 sourceCategory 填充
  // 显式生命周期：NEW / CONTACTED / LOST / ENROLLED
  status    String  @default("NEW")
  sourceCategory     String?
  sourceDetail       String?
  subjectsOfInterest String?
  campaignId         String?
  createdAt DateTime @default(now())

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([status])
  @@index([campaignId])
}

model Campaign {
  id             String   @id @default(cuid())
  name           String
  sourceCategory String
  sourceDetail   String
  campusId       String
  defaultOwnerId String?
  active         Boolean  @default(true)
  token          String   @unique
  createdAt      DateTime @default(now())

  campus       Campus @relation(fields: [campusId], references: [id])
  defaultOwner User?  @relation("CampaignOwner", fields: [defaultOwnerId], references: [id])
  leads        Lead[]
}

// 每次导入都留痕：时间、来源、结果、原始 payload，便于排障。
model LeadImportLog {
  id        String   @id @default(cuid())
  source    String   // API / CSV / PUBLIC_FORM
  result    String   // CREATED / MERGED / REJECTED
  studentId String?
  message   String?
  payload   String   // 原始 payload 的 JSON 文本
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FollowUp {
  id            String    @id @default(cuid())
  studentId     String
  salesId       String
  contactMethod String
  content       String
  followedAt    DateTime
  nextFollowUp  DateTime?
  createdAt     DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sales   User    @relation(fields: [salesId], references: [id])
}

model CoursePackage {
  id             String    @id @default(cuid())
  studentId      String
  gradeId        String
  subjectId      String
  totalHours     Float
  pricePerHour   Float
  totalAmount    Float
  remainingHours Float
  status         String    @default("PENDING_APPROVAL")
  signingType    String    @default("NEW_SIGN") // 签约类型：新签 NEW_SIGN / 续费 RENEWAL（首张新签，之后续费）
  // 授课形式：ONE_ON_ONE 一对一 / GROUP 班课。签约时定死，与 signingType 是两个维度。
  // 只有 GROUP 课包能加入班级；ONE_ON_ONE 走单人排课。
  classType      String    @default("ONE_ON_ONE")
  // 课包转化：本包由哪张包转来（1:1），以及转化时家长补的差额。
  // 原包转出后置为 CONVERTED 并把剩余价值内部退回账户，新包用它抵扣。
  convertedFromId String?  @unique
  topUpAmount     Float?
  createdById    String
  confirmedById  String?    // 校长确认人
  confirmedAt    DateTime?
  financeConfirmedById String?  // 财务确认人（二次确认，正式生效）
  financeConfirmedAt   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  student          Student  @relation(fields: [studentId], references: [id])
  grade            Grade    @relation(fields: [gradeId], references: [id])
  subject          Subject  @relation(fields: [subjectId], references: [id])
  creator          User     @relation("PackageCreator", fields: [createdById], references: [id])
  confirmer        User?    @relation("PackageConfirmer", fields: [confirmedById], references: [id])
  financeConfirmer User?    @relation("PackageFinanceConfirmer", fields: [financeConfirmedById], references: [id])

  lessons    ScheduledLesson[]
  deductions CourseDeduction[]
  ledgerEntries LedgerEntry[]
  refunds       RefundRequest[]
  classMemberships GroupClassMember[]

  convertedFrom CoursePackage? @relation("PackageConversion", fields: [convertedFromId], references: [id])
  convertedTo   CoursePackage? @relation("PackageConversion")
}

model Classroom {
  id       String @id @default(cuid())
  name     String
  campusId String
  capacity Int?

  campus  Campus            @relation(fields: [campusId], references: [id])
  lessons ScheduledLesson[]
  groupClasses   GroupClass[]
  groupSessions  GroupSession[]
}

model ScheduledLesson {
  id          String   @id @default(cuid())
  teacherId   String
  studentId   String
  packageId   String
  // 线上课不占实体教室，classroomId 为空；线下课必填。
  classroomId String?
  startTime   DateTime
  endTime     DateTime
  lessonType  String   @default("ONE_ON_ONE")
  // ONSITE 线下 / ONLINE 线上
  deliveryMode String  @default("ONSITE")
  createdAt   DateTime @default(now())
  // 考勤：PRESENT 到课 / LEAVE 请假 / NO_SHOW 旷课；null = 尚未标记（按到课处理）。
  // 扣不扣课时由考勤决定：1对1 请假不扣、旷课照扣；班课请假默认照扣（可手动撤销）。
  attendance     String?
  attendanceNote String?
  attendanceById String?
  attendanceAt   DateTime?

  teacher   User          @relation(fields: [teacherId], references: [id])
  student   Student       @relation(fields: [studentId], references: [id])
  package   CoursePackage @relation(fields: [packageId], references: [id])
  classroom Classroom?    @relation(fields: [classroomId], references: [id])
  attendanceMarker User?  @relation("AttendanceMarker", fields: [attendanceById], references: [id])

  log LessonLog?
}

model LessonLog {
  id            String    @id @default(cuid())
  lessonId      String    @unique
  teacherId     String
  subjectId     String
  notes         String
  submittedAt   DateTime  @default(now())
  confirmedById String?
  confirmedAt   DateTime?

  lesson     ScheduledLesson   @relation(fields: [lessonId], references: [id])
  teacher    User              @relation("LogTeacher", fields: [teacherId], references: [id])
  subject    Subject           @relation(fields: [subjectId], references: [id])
  confirmer  User?             @relation("LogConfirmer", fields: [confirmedById], references: [id])
  // 一对多：核销→撤销→再核销会留下多条记录，生效的是 reversedAt 为空的那条，
  // 已撤销的保留下来作为审计痕迹。
  deductions CourseDeduction[]
}

// 课时消耗的唯一台账，一对一与班课共用：
// 一对一挂 logId（老师日志），班课挂 groupSessionId（班级课次），两者恰有其一。
model CourseDeduction {
  id            String    @id @default(cuid())
  packageId     String
  logId         String?
  groupSessionId String?
  hoursDeducted Float
  createdAt     DateTime  @default(now())
  reversedAt    DateTime?
  reversedById  String?
  // 财务锁：核销确认满一周自动锁定，锁定后不能撤销；财务可解锁一条以便更正。
  financeUnlockedAt   DateTime?
  financeUnlockedById String?

  package        CoursePackage @relation(fields: [packageId], references: [id])
  log            LessonLog?    @relation(fields: [logId], references: [id])
  groupSession   GroupSession? @relation(fields: [groupSessionId], references: [id])
  reverser       User?         @relation(fields: [reversedById], references: [id])
  financeUnlocker User?        @relation("DeductionUnlocker", fields: [financeUnlockedById], references: [id])
}

// 学生账户流水（账本）。余额 = 该生所有流水 amount 之和。
// 正数 = 价值进入账户（家长交钱、课包剩余价值退回）；
// 负数 = 价值离开账户（建课包占用、实际退款打出）。
// 一次业务动作可能产生多条流水（如转化 = 退课入账 + 补款 + 课包扣款）。
model LedgerEntry {
  id        String   @id @default(cuid())
  studentId String
  // PAYMENT 收款 / PACKAGE_CHARGE 课包扣款 / REFUND_CREDIT 退课入账 / REFUND_PAYOUT 退款打出
  type      String
  amount    Float
  packageId String?
  refundId  String?
  note      String?
  createdById String
  createdAt DateTime @default(now())

  student   Student        @relation(fields: [studentId], references: [id])
  package   CoursePackage? @relation(fields: [packageId], references: [id])
  refund    RefundRequest? @relation(fields: [refundId], references: [id])
  creator   User           @relation("LedgerCreator", fields: [createdById], references: [id])

  @@index([studentId, createdAt])
}

// 退费申请：按原单价退未消耗课时，不收手续费，支持部分退。
// 流程：学管发起 → 校长审核(PENDING_FINANCE) → 财务复核打款(PAID)。
// 打款那一刻才动课包课时并写账本，避免未审批就减库存。
model RefundRequest {
  id           String   @id @default(cuid())
  studentId    String
  packageId    String
  hours        Float    // 退的课时数
  pricePerHour Float    // 原单价快照（审批期间课包被改也按发起时口径）
  amount       Float    // hours × pricePerHour
  // PENDING_APPROVAL 待校长审核 / PENDING_FINANCE 待财务复核 / PAID 已退款 / REJECTED 已驳回
  status       String   @default("PENDING_APPROVAL")
  reason       String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  paidById     String?
  paidAt       DateTime?
  rejectedById String?
  rejectedAt   DateTime?
  rejectReason String?
  createdAt    DateTime @default(now())

  student  Student       @relation(fields: [studentId], references: [id])
  package  CoursePackage @relation(fields: [packageId], references: [id])
  creator  User          @relation("RefundCreator", fields: [createdById], references: [id])
  approver User?         @relation("RefundApprover", fields: [approvedById], references: [id])
  payer    User?         @relation("RefundPayer", fields: [paidById], references: [id])
  rejecter User?         @relation("RefundRejecter", fields: [rejectedById], references: [id])

  ledgerEntries LedgerEntry[]

  @@index([studentId])
  @@index([status])
}

// 班级。班课以班级为单位排课与消课；成员各自用一张班课课包占一个席位。
// 同一班级必须同科目（业务规则），年级可留空以容纳相近年级混班。
model GroupClass {
  id          String   @id @default(cuid())
  name        String
  campusId    String
  subjectId   String
  gradeId     String?
  teacherId   String?  // 默认老师，排课时可改
  classroomId String?  // 默认教室
  // 班级默认授课形式，排课时预填，单次课仍可改。ONSITE 线下 / ONLINE 线上
  deliveryMode String  @default("ONSITE")
  capacity    Int?     // 席位上限，留空为不限
  // RECRUITING 招生中 / ONGOING 进行中 / FINISHED 已结班
  status      String   @default("RECRUITING")
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  campus    Campus     @relation(fields: [campusId], references: [id])
  subject   Subject    @relation(fields: [subjectId], references: [id])
  grade     Grade?     @relation(fields: [gradeId], references: [id])
  teacher   User?      @relation("ClassTeacher", fields: [teacherId], references: [id])
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  creator   User       @relation("ClassCreator", fields: [createdById], references: [id])

  members  GroupClassMember[]
  sessions GroupSession[]

  @@index([campusId, status])
}

// 班级成员 = 学生 + 其班课课包。中途插班/退班用 joinedAt/leftAt 记录，
// 排课时只算当时在册的成员，避免把没上过的课算到头上。
model GroupClassMember {
  id        String    @id @default(cuid())
  classId   String
  studentId String
  packageId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  class   GroupClass    @relation(fields: [classId], references: [id])
  student Student       @relation(fields: [studentId], references: [id])
  package CoursePackage @relation(fields: [packageId], references: [id])

  // 一张课包在一个班里只占一个席位
  @@unique([classId, packageId])
  @@index([classId])
  @@index([studentId])
}

// 班级的一次课。排到课表上的就是它；老师整班写一条反馈，教务确认后全员各自扣课时。
model GroupSession {
  id          String   @id @default(cuid())
  classId     String
  teacherId   String
  // 线上课次不占实体教室，classroomId 为空；线下必填。
  classroomId String?
  startTime   DateTime
  endTime     DateTime
  // ONSITE 线下 / ONLINE 线上
  deliveryMode String  @default("ONSITE")
  // SCHEDULED 已排课 / LOGGED 待确认 / CONFIRMED 已核销
  status      String   @default("SCHEDULED")
  // 老师反馈：整班一条
  notes         String?
  loggedById    String?
  loggedAt      DateTime?
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime @default(now())

  class     GroupClass @relation(fields: [classId], references: [id])
  teacher   User       @relation("SessionTeacher", fields: [teacherId], references: [id])
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  logger    User?      @relation("SessionLogger", fields: [loggedById], references: [id])
  confirmer User?      @relation("SessionConfirmer", fields: [confirmedById], references: [id])

  attendances GroupSessionAttendance[]
  deductions  CourseDeduction[]

  @@index([classId, startTime])
  @@index([startTime])
}

// 每次课 × 每个在册成员一条考勤。请假默认仍扣（座位已占），可手动撤销那一笔。
model GroupSessionAttendance {
  id         String  @id @default(cuid())
  sessionId  String
  studentId  String
  packageId  String
  attendance String  @default("PRESENT")
  note       String?

  session GroupSession @relation(fields: [sessionId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
