generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  roles    UserRole[]
  campuses UserCampus[]

  studentsAsSales    Student[]         @relation("StudentSales")
  packagesCreated    CoursePackage[]   @relation("PackageCreator")
  packagesConfirmed  CoursePackage[]   @relation("PackageConfirmer")
  followUps          FollowUp[]
  lessonsAsTeacher   ScheduledLesson[]
  lessonLogs         LessonLog[]       @relation("LogTeacher")
  logConfirmations   LessonLog[]       @relation("LogConfirmer")
  deductionReversals CourseDeduction[]
  notifications      Notification[]
  campaignsOwned     Campaign[]        @relation("CampaignOwner")
}

model UserRole {
  userId String
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model UserCampus {
  userId   String
  campusId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@id([userId, campusId])
}

model Campus {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users      UserCampus[]
  students   Student[]
  classrooms Classroom[]
  campaigns  Campaign[]
}

model Grade {
  id   String @id @default(cuid())
  name String @unique

  students Student[]
  packages CoursePackage[]
}

model Subject {
  id   String @id @default(cuid())
  name String @unique

  packages   CoursePackage[]
  lessonLogs LessonLog[]
}

model Student {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  // 线索导入时年级可能未知，故可空。建档 UI 仍要求填写。
  gradeId      String?
  publicSchool String?
  salesId      String?
  campusId     String
  // 加拿大用邮编（前三位 FSA）划分营销区域。
  postalCode   String?
  // 家长偏好联系 App 与其账号，contactAppId 参与去重。
  preferredContactApp String?
  contactAppId        String?
  createdAt    DateTime @default(now())

  grade    Grade?  @relation(fields: [gradeId], references: [id])
  sales    User?   @relation("StudentSales", fields: [salesId], references: [id])
  campus   Campus  @relation(fields: [campusId], references: [id])

  leadInfo  Lead?
  followUps FollowUp[]
  packages  CoursePackage[]
  lessons   ScheduledLesson[]

  @@index([contactAppId])
}

model Lead {
  studentId String  @id
  source    String  // 兼容旧字段，导入时以 sourceCategory 填充
  // 显式生命周期：NEW / CONTACTED / LOST / ENROLLED
  status    String  @default("NEW")
  sourceCategory     String?
  sourceDetail       String?
  subjectsOfInterest String?
  campaignId         String?
  createdAt DateTime @default(now())

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([status])
  @@index([campaignId])
}

model Campaign {
  id             String   @id @default(cuid())
  name           String
  sourceCategory String
  sourceDetail   String
  campusId       String
  defaultOwnerId String?
  active         Boolean  @default(true)
  token          String   @unique
  createdAt      DateTime @default(now())

  campus       Campus @relation(fields: [campusId], references: [id])
  defaultOwner User?  @relation("CampaignOwner", fields: [defaultOwnerId], references: [id])
  leads        Lead[]
}

// 每次导入都留痕：时间、来源、结果、原始 payload，便于排障。
model LeadImportLog {
  id        String   @id @default(cuid())
  source    String   // API / CSV / PUBLIC_FORM
  result    String   // CREATED / MERGED / REJECTED
  studentId String?
  message   String?
  payload   String   // 原始 payload 的 JSON 文本
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FollowUp {
  id            String    @id @default(cuid())
  studentId     String
  salesId       String
  contactMethod String
  content       String
  followedAt    DateTime
  nextFollowUp  DateTime?
  createdAt     DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sales   User    @relation(fields: [salesId], references: [id])
}

model CoursePackage {
  id             String    @id @default(cuid())
  studentId      String
  gradeId        String
  subjectId      String
  totalHours     Float
  pricePerHour   Float
  totalAmount    Float
  remainingHours Float
  status         String    @default("PENDING_APPROVAL")
  createdById    String
  confirmedById  String?
  confirmedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  student   Student  @relation(fields: [studentId], references: [id])
  grade     Grade    @relation(fields: [gradeId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  creator   User     @relation("PackageCreator", fields: [createdById], references: [id])
  confirmer User?    @relation("PackageConfirmer", fields: [confirmedById], references: [id])

  lessons    ScheduledLesson[]
  deductions CourseDeduction[]
}

model Classroom {
  id       String @id @default(cuid())
  name     String
  campusId String
  capacity Int?

  campus  Campus            @relation(fields: [campusId], references: [id])
  lessons ScheduledLesson[]
}

model ScheduledLesson {
  id          String   @id @default(cuid())
  teacherId   String
  studentId   String
  packageId   String
  classroomId String
  startTime   DateTime
  endTime     DateTime
  lessonType  String   @default("ONE_ON_ONE")
  createdAt   DateTime @default(now())

  teacher   User          @relation(fields: [teacherId], references: [id])
  student   Student       @relation(fields: [studentId], references: [id])
  package   CoursePackage @relation(fields: [packageId], references: [id])
  classroom Classroom     @relation(fields: [classroomId], references: [id])

  log LessonLog?
}

model LessonLog {
  id            String    @id @default(cuid())
  lessonId      String    @unique
  teacherId     String
  subjectId     String
  notes         String
  submittedAt   DateTime  @default(now())
  confirmedById String?
  confirmedAt   DateTime?

  lesson     ScheduledLesson   @relation(fields: [lessonId], references: [id])
  teacher    User              @relation("LogTeacher", fields: [teacherId], references: [id])
  subject    Subject           @relation(fields: [subjectId], references: [id])
  confirmer  User?             @relation("LogConfirmer", fields: [confirmedById], references: [id])
  // 一对多：核销→撤销→再核销会留下多条记录，生效的是 reversedAt 为空的那条，
  // 已撤销的保留下来作为审计痕迹。
  deductions CourseDeduction[]
}

model CourseDeduction {
  id            String    @id @default(cuid())
  packageId     String
  logId         String
  hoursDeducted Float
  createdAt     DateTime  @default(now())
  reversedAt    DateTime?
  reversedById  String?

  package  CoursePackage @relation(fields: [packageId], references: [id])
  log      LessonLog     @relation(fields: [logId], references: [id])
  reverser User?         @relation(fields: [reversedById], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
